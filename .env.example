# Plantilla de entorno para los servicios de graphify (docker compose).
# Copia este archivo a .env en la raiz del repo y rellena los valores.
# .env NUNCA se versiona (esta en .gitignore).

# --- LLM para la extraccion semantica (backend openai de graphify) ---
# Endpoint OpenAI-compatible propio (no usar api.openai.com a menos que sea tu caso).
# graphify lee OPENAI_BASE_URL, OPENAI_MODEL y OPENAI_API_KEY (graphify/llm.py).
OPENAI_BASE_URL=<endpoint-openai-compatible-v1>
OPENAI_MODEL=<nombre-del-modelo>
OPENAI_API_KEY=

# Si ambos servidores requieren autenticacion, pon aqui tu clave de infraestructura.
# INFRA_API_KEY=tu-clave-opcional

# --- Autenticacion del MCP de graphify ---
# Clave que el servidor exige en el header X-API-Key (obligatoria si publicas el puerto).
GRAPHIFY_API_KEY=

# --- Puertos (defaults alineados con deploy/graphify/docker-compose.yml) ---
# GRAPHIFY_PORT=8080
# MEMGRAPH_HTTP_PORT=8000
# MEMGRAPH_BOLT_PORT=7687

# --- Workspace a indexar ---
# Raiz del repositorio a convertir en grafo (default: la carpeta donde corre
# node tools/build-graphify.mjs). Si usas compose directo, definela explicita.
# GRAPHIFY_WORKSPACE=/ruta/al/repo

# --- Conmutacion build <-> Docker Hub (sin editar el yml) ---
# build (default): construye graphify-local:0.9.102 con deploy/graphify/Dockerfile.
# dockerhub: usa sinfallas/remote-graphify:latest (pull, sin build local).
# GRAPHIFY_IMAGE_SOURCE=build
# GRAPHIFY_IMAGE=gana-sobre-IMAGE_SOURCE

# --- Backend de extraccion ---
# GRAPHIFY_BACKEND=openai
